		{
			"name": "2. Ingest Document (Sentence Strategy)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Save document_id to collection variable",
							"var jsonData = pm.response.json();",
							"pm.collectionVariables.set(\"document_id\", jsonData.document_id);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "file",
							"type": "file",
							"src": "sample_document.txt",
							"description": "Upload a PDF or TXT file"
						}
					]
				},
				"url": {
					"raw": "{{base_url}}/ingest?strategy=sentence",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"ingest"
					],
					"query": [
						{
							"key": "strategy",
							"value": "sentence",
							"description": "Chunking strategy: 'sentence' or 'fixed'"
						}
					]
				},
				"description": "Upload a document (PDF/TXT) and generate vector embeddings. Uses sentence-based chunking strategy. The document_id is automatically saved for use in subsequent requests."
			},
			"response": [
				{
					"name": "Success Response",
					"originalRequest": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": "sample_document.txt"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/ingest?strategy=sentence",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"ingest"
							],
							"query": [
								{
									"key": "strategy",
									"value": "sentence"
								}
							]
						}
					},
					"status": "OK",
					"code": 200,
					"_postman_previewlanguage": "json",
					"header": [
						{
							"key": "Content-Type",
							"value": "application/json"
						}
					],
					"body": "{\n  \"document_id\": \"7d4b9197-d256-481d-b5b2-a1ec2653d73d\",\n  \"filename\": \"sample_document.txt\",\n  \"chunk_count\": 21,\n  \"strategy\": \"sentence\"\n}"
				}
			]
		},
